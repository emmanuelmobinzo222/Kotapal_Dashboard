# KotaPal production — copy to .env before launch (no manual product setup required)

PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# Live product search (SearchAPI.io) — used automatically by the app
SEARCHAPI_API_KEY=your-searchapi-key
SEARCHAPI_AMAZON_URL=https://www.searchapi.io/api/v1/search
SEARCHAPI_WALMART_URL=https://www.searchapi.io/api/v1/search
SEARCHAPI_EBAY_URL=https://www.searchapi.io/api/v1/search

# Optional: Redis for real-time analytics (app runs without it)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis-secure-password
