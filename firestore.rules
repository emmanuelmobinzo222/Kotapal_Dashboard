rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: true if current user is admin (hardcoded or in config/admins)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@kotapal.com' ||
        (exists(/databases/$(database)/documents/config/admins) && 
         get(/databases/$(database)/documents/config/admins).data.emails.hasAny([request.auth.token.email]))
      );
    }
    
    // Config - admins list: first user can create; only admins can update
    match /config/admins {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/config/admins);
      allow update: if request.auth != null && resource.data.emails.hasAny([request.auth.token.email]);
      allow delete: if false;
    }
    
    // Users - each user can read/write own doc; admins can read and update all
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow delete: if false;
    }
    
    // Blocks - users can read/write own blocks; admins can read all
    match /blocks/{blockId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
