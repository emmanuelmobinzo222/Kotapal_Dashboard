rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Config - admins list: first user can create; only admins can update
    match /config/admins {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/config/admins);
      allow update: if request.auth != null && request.auth.token.email in resource.data.emails;
      allow delete: if false;
    }
    
    // Users - each user can read/write own doc; admins can read all
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'admin@kotapal.com' ||
        (exists(/databases/$(database)/documents/config/admins) && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails)
      );
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // Blocks - users can read/write own blocks; admins can read all
    match /blocks/{blockId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == 'admin@kotapal.com' ||
        (exists(/databases/$(database)/documents/config/admins) && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails)
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
