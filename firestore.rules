rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - each user can read/write own doc; admin@kotapal.com can read all (case-insensitive)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email.toLowerCase() == 'admin@kotapal.com')
      );
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // Blocks - users can read/write own blocks; admin@kotapal.com can read all (case-insensitive)
    match /blocks/{blockId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && request.auth.token.email.toLowerCase() == 'admin@kotapal.com')
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
